{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "agentrouter": {
      "name": "AgenRouter",
      "npm": "@ai-sdk/openai",

      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "dummy"
      },

      "models": {
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol",
          "id": "gpt-5.6-sol"
        },

        "gpt-6-astra": {
          "name": "GPT 6 Astra",
          "id": "gpt-6-astra"
        },

        "gpt-6.1-sol": {
          "name": "GPT 6.1 Sol",
          "id": "gpt-6.1-sol",
          "options": {
            "useResponsesApi": true
          }
        }
      }
    }
}
}
